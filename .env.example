# Copy to .env and fill in. Never commit .env.
# Production secrets should go in Windows Credential Manager via the keyring wrapper,
# not in .env. This file is for local development defaults only.

# === Core ===
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# === Database ===
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
# pgvector extension must be enabled in the target DB

# === Auth ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JARVIS_SECRET_KEY=change-me-before-anything-real
JARVIS_ACCESS_TOKEN_TTL_MIN=60

# === Local AI (Ollama) ===
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# === Cloud AI (optional — non-sensitive tasks only) ===
# Prefer keyring in production. .env value is dev-only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Integrations (OAuth client IDs — secrets live in keyring) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:8000/auth/google/callback

# === Voice ===
WHISPER_MODEL=base.en
TTS_VOICE=default

# === Permission defaults ===
# Levels: read_only | draft_only | ask_before_action | approved_automation | admin
JARVIS_DEFAULT_PERMISSION=ask_before_action
